# ==========================================
# ENV PRODUCTION (Turso Prod Database)
# Salin menjadi .env.production lalu jalankan: npm run db:push:prod
# ==========================================
TURSO_DATABASE_URL=libsql://absen-prod-USERNAME.turso.io
TURSO_AUTH_TOKEN=isi_token_turso_prod_disini

# JWT Secret wajib acak panjang (>= 32 karakter) di production
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter-di-vercel

# Opsional: fallback jika belum diatur di Web Admin (/settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Akun awal System Custodian saat db:push:prod pertama kali
SEED_CUSTODIAN_CODE=CUST-001
SEED_CUSTODIAN_NAME=System Custodian
