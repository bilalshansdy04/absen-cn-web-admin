# ==========================================
# ENV DEVELOPMENT (Turso Dev Database)
# Dipakai oleh: npm run dev & npm run db:push:dev
# ==========================================
TURSO_DATABASE_URL=libsql://absen-dev-USERNAME.turso.io
TURSO_AUTH_TOKEN=isi_token_turso_dev_disini

# JWT Secret untuk dev
JWT_SECRET=dev-secret-presensi-ganti-di-production-minimal-32-karakter

# Opsional: fallback jika belum diatur di Web Admin (/settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Akun awal System Custodian saat db:push:dev pertama kali
SEED_CUSTODIAN_CODE=CUST-001
SEED_CUSTODIAN_NAME=System Custodian
