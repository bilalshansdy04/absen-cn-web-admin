# Turso / libSQL Database
# Kosongkan atau gunakan file:local.db untuk pengembangan lokal SQLite
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# JWT Secret (wajib diganti dengan string acak panjang di production)
JWT_SECRET=dev-secret-presensi-ganti-di-production-minimal-32-karakter

# Opsional: fallback jika belum diatur di Web Admin -> /settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Akun Super Admin (System Custodian) awal saat bootstrap pertama kali
SEED_CUSTODIAN_CODE=CUST-001
SEED_CUSTODIAN_NAME=System Custodian
